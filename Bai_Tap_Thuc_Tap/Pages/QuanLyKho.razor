@page "/kho"
@using Bai_Tap_Thuc_Tap.Data
@using Bai_Tap_Thuc_Tap.Data.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject IJSRuntime JSRuntime

<h3>Danh Mục Kho</h3>
<hr />

<button class="btn btn-primary mb-3" @onclick="ShowAddModal">
    <i class="fas fa-plus"></i> Thêm Mới
</button>

@if (danhSachKho == null)
{
    <p><em>Đang tải dữ liệu...</em></p>
}
else
{
    <table class="table table-bordered table-hover">
        <thead class="thead-light">
            <tr>
                <th>Tên Kho</th>
                <th>Ghi Chú</th>
                <th style="width: 150px;">Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kho in danhSachKho)
            {
                <tr>
                    <td>@kho.TenKho</td>
                    <td>@kho.GhiChu</td>
                    <td>
                        <button class="btn btn-sm btn-warning" @onclick="() => ShowEditModal(kho)">Sửa</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => XoaKho(kho.Id)">Xóa</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showModal)
{
    <div class="modal fade show" tabindex="-1" style="display: block;">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="@khoHienTai" OnValidSubmit="LuuThayDoi">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@(isEditing ? "Chỉnh Sửa Kho" : "Thêm Mới Kho")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Tên Kho</label>
                            <InputText class="form-control" @bind-Value="khoHienTai.TenKho" />
                            <ValidationMessage For="@(() => khoHienTai.TenKho)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Ghi Chú</label>
                            <InputTextArea class="form-control" @bind-Value="khoHienTai.GhiChu" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Hủy</button>
                        <button type="submit" class="btn btn-success">Lưu</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<Kho>? danhSachKho;
    private Kho khoHienTai = new();
    private bool showModal = false;
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        await TaiDanhSach();
    }

    private async Task TaiDanhSach()
    {
        danhSachKho = await DbContext.Khos.OrderBy(k => k.TenKho).ToListAsync();
    }

    private void ShowAddModal()
    {
        khoHienTai = new Kho();
        isEditing = false;
        showModal = true;
    }

    private void ShowEditModal(Kho khoToEdit)
    {
        khoHienTai = new Kho
        {
            Id = khoToEdit.Id,
            TenKho = khoToEdit.TenKho,
            GhiChu = khoToEdit.GhiChu
        };
        isEditing = true;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task LuuThayDoi()
    {
        var tenDaTonTai = await DbContext.Khos
            .AnyAsync(k => k.TenKho.ToLower() == khoHienTai.TenKho.ToLower() && k.Id != khoHienTai.Id);
        if (tenDaTonTai)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Lỗi: Tên kho này đã tồn tại!");
            return;
        }

        if (isEditing)
        {

            var dbKho = await DbContext.Khos.FindAsync(khoHienTai.Id);

            if (dbKho != null)
            {
                dbKho.TenKho = khoHienTai.TenKho;
                dbKho.GhiChu = khoHienTai.GhiChu;
            }
        }
        else
        {
            await DbContext.Khos.AddAsync(khoHienTai);
        }

        await DbContext.SaveChangesAsync();
        CloseModal();
        await TaiDanhSach();
    }

    private async Task XoaKho(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa kho này không?");
        if (confirmed)
        {
            var khoToDelete = await DbContext.Khos.FindAsync(id);
            if (khoToDelete != null)
            {
                DbContext.Khos.Remove(khoToDelete);
                await DbContext.SaveChangesAsync();
                await TaiDanhSach();
            }
        }
    }
}