@page "/sua-phieu-xuat/{Id:int}"
@using Bai_Tap_Thuc_Tap.Data
@using Bai_Tap_Thuc_Tap.Data.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<h3>Hiệu Chỉnh Thông Tin Phiếu Xuất</h3>

@if (phieuXuat == null)
{
    <p><em>Đang tải thông tin phiếu xuất...</em></p>
}
else
{
    <EditForm Model="@phieuXuat" OnValidSubmit="LuuThayDoi">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="card">
            <div class="card-header">Thông Tin Chung</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Số Phiếu Xuất</label>
                        <InputText class="form-control" @bind-Value="phieuXuat.SoPhieuXuatKho" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Ngày Xuất Kho</label>
                        <InputDate class="form-control" @bind-Value="phieuXuat.NgayXuatKho" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Kho Xuất</label>
                        <InputSelect class="form-control" @bind-Value="phieuXuat.KhoId">
                            <option value="0">-- Chọn kho --</option>
                            @if (danhSachKho != null)
                                {
                                @foreach (var k in danhSachKho)
                                    {
                                    <option value="@k.Id">@k.TenKho</option>
                                    }
                                }
                        </InputSelect>
                    </div>
                    <div class="col-md-8 mb-3">
                        <label class="form-label">Ghi Chú</label>
                        <InputText class="form-control" @bind-Value="phieuXuat.GhiChu" />
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success">Lưu Thay Đổi</button>
            <button type="button" class="btn btn-secondary" @onclick="HuyBo">Hủy</button>
        </div>
    </EditForm>
}

@code {
    // Nhận tham số Id từ URL
    [Parameter]
    public int Id { get; set; }

    private XuatKho? phieuXuat;
    private List<Kho>? danhSachKho;
    private string soPhieuBanDau = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Tải danh sách kho cho dropdown
        danhSachKho = await DbContext.Khos.ToListAsync();

        // Tải thông tin phiếu xuất cần sửa
        phieuXuat = await DbContext.XuatKhos.FindAsync(Id);

        if (phieuXuat != null)
        {
            // Lưu lại số phiếu ban đầu để kiểm tra nếu người dùng thay đổi
            soPhieuBanDau = phieuXuat.SoPhieuXuatKho;
        }
    }

    private async Task LuuThayDoi()
    {
        if (phieuXuat == null) return;

        // Ràng buộc: Kiểm tra trùng số phiếu NẾU nó đã bị thay đổi
        if (phieuXuat.SoPhieuXuatKho != soPhieuBanDau)
        {
            var daTonTai = await DbContext.XuatKhos
                .AnyAsync(p => p.SoPhieuXuatKho == phieuXuat.SoPhieuXuatKho && p.Id != phieuXuat.Id);
            if (daTonTai)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Lỗi: Số phiếu xuất này đã tồn tại!");
                return;
            }
        }

        // Cập nhật vào DbContext
        DbContext.XuatKhos.Update(phieuXuat);
        await DbContext.SaveChangesAsync();

        // Quay về trang danh sách
        NavigationManager.NavigateTo("/phieu-xuat");
    }

    private void HuyBo()
    {
        NavigationManager.NavigateTo("/phieu-xuat");
    }
}